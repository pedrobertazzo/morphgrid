{
  "name": "morphgrid",
  "version": "0.2.1",
  "description": "A React grid where the cell decides how an item is shown. Drag items between cells and they morph to fit.",
  "keywords": [
    "react",
    "grid",
    "dashboard",
    "drag-and-drop",
    "layout",
    "morph",
    "css-grid",
    "data-visualization"
  ],
  "author": "Pedro Geciauskas Bertazzo",
  "license": "MIT",
  "homepage": "https://pedrobertazzo.github.io/morphgrid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrobertazzo/morphgrid.git"
  },
  "bugs": {
    "url": "https://github.com/pedrobertazzo/morphgrid/issues"
  },
  "type": "module",
  "main": "./dist/morphgrid.cjs",
  "module": "./dist/morphgrid.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/morphgrid.js",
      "require": "./dist/morphgrid.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "build:demo": "vite build --config demo/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
